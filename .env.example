# Copy this file to .env.local and fill in the real values.
#   cp .env.example .env.local
#
# .env.local is ignored by git and must stay that way. This example file
# is committed, and is the only record of what the app needs to run, so
# add a line here whenever you add a new setting — with a placeholder,
# never a real value.

# --- Supabase ---------------------------------------------------------
# Both of these are safe to have in the app. They are sent to every
# visitor's browser by design. What actually protects the data is the
# row-level security rules on the tables, not these.
#
# Find them at: Supabase dashboard -> your project -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# --- Where this copy of the site lives --------------------------------
# Used to build the link inside confirmation and password-reset emails.
#
# Locally this is http://localhost:3000. In production it MUST be the
# real address — if it is missing or wrong, people get emailed a link
# that goes nowhere and can never finish signing up. The app refuses to
# send those emails in production rather than let that happen quietly.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Google Books -----------------------------------------------------
# Needed for the "suggest a book" search. A key is required: calling the
# API without one returns 429 with a quota of zero, whatever older
# guides say.
#
# To get one (free):
#   1. Go to https://console.cloud.google.com
#   2. Create a project, or pick an existing one
#   3. Enable the "Books API" for it
#   4. APIs & Services -> Credentials -> Create credentials -> API key
#   5. Paste it below
#
# Without this, book search reports that it is not set up rather than
# showing an empty list that would look like "no such book".
GOOGLE_BOOKS_API_KEY=
